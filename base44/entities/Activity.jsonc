{
  "name": "Activity",
  "type": "object",
  "properties": {
    "child_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "why": {
      "type": "string"
    },
    "minutes": {
      "type": "number",
      "default": 5
    },
    "domain": {
      "type": "string",
      "enum": [
        "language",
        "motor",
        "social",
        "emotional",
        "cognitive",
        "creativity"
      ]
    },
    "place": {
      "type": "string",
      "description": "\u05de\u05e7\u05d5\u05dd/\u05e1\u05d9\u05d8\u05d5\u05d0\u05e6\u05d9\u05d4, \u05e8\u05d9\u05e7 \u05dc\u05e4\u05e2\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea \u05db\u05dc\u05dc\u05d9\u05d5\u05ea"
    },
    "image_url": {
      "type": "string"
    },
    "tips": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parent_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "child_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.parent_emails": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.parent_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.parent_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}